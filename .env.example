# Local development. Copy to .env; never commit real values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://nexora:nexora@localhost:5433/nexora?connect_timeout=5&pool_timeout=5
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
# Generate each independently: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
AI_KEY_ENCRYPTION_SECRET=
METRICS_TOKEN=
# Generate: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=
# Only for development. Both must be false in staging/production.
HTTP_NODE_ALLOW_LOOPBACK=false
ALLOW_PRIVATE_HOSTS=false
HTTP_DEFAULT_TIMEOUT_MS=10000
HTTP_MAX_RESPONSE_BYTES=2097152
# SMTP: required operationally for real email; empty values log to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
DOCUMENT_UPLOAD_MAX_BYTES=15728640
DOCUMENT_STORAGE_PATH=/tmp/nexora-uploads
DOCUMENT_WORKER_CONCURRENCY=2
# Legacy setting: BullMQ does not enforce this job timeout. See production checklist.
DOCUMENT_JOB_TIMEOUT_MS=300000
# Optional local traineddata directory; Compose defaults to /usr/share/tessdata (bundled spa+eng).
OCR_LANG_PATH=
OCR_MIN_CONFIDENCE=70
DOCUMENT_TOTAL_TOLERANCE=0.01
DOCUMENT_RATE_LIMIT_WINDOW_MS=900000
DOCUMENT_RATE_LIMIT_MAX=30
LOG_LEVEL=info
AUDIT_RETENTION_DAYS=365
METRICS_RETENTION_DAYS=90
# Vite development proxy; production frontend uses Nginx.
API_PROXY=http://localhost:3000
# Test runner uses these only; database name must end _test, Redis must use /1.
TEST_DATABASE_URL=postgresql://nexora_test:nexora_test@localhost:55433/nexora_test
TEST_REDIS_URL=redis://localhost:56380/1
# Compose deployment only. Copy into a separate .env.production / .env.staging.
# Change NODE_ENV, DATABASE_URL, REDIS_URL, CORS_ORIGINS, TRUST_PROXY_HOPS=2,
# DOCUMENT_STORAGE_PATH=/data/uploads. Use container DNS postgres and redis.
DOMAIN=app.example.com
IMAGE_PREFIX=ghcr.io/your-owner/nexora-ai
IMAGE_TAG=replace-with-full-verified-git-sha
POSTGRES_USER=nexora
POSTGRES_DB=nexora
POSTGRES_PASSWORD=
REDIS_PASSWORD=
APP_ENV_FILE=.env.production
BACKUP_DIR=./backups
