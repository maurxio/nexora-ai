{
  "name": "@nexora/api",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=../../.env src/server.js",
    "start": "node src/server.js",
    "test": "node --import ../../test/env.js --test --test-timeout=30000 --test-concurrency=1 test/*.test.js",
    "test:unit": "node --import ../../test/env.js --test --test-timeout=30000 --test-concurrency=1 test/*.unit.test.js test/documents.rules.test.js",
    "test:integration": "node --import ../../test/env.js --test --test-timeout=30000 --test-concurrency=1 test/*.integration.test.js test/approvals.test.js",
    "build": "node ../../scripts/check-js.js src",
    "test:coverage": "c8 --all --include=\"src/**/*.js\" --exclude=\"**/server.js\" --exclude=\"**/bootstrap.js\" --reporter=text --reporter=lcov npm test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.63.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.4",
    "file-type": "^19.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.5.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "tesseract.js": "^5.1.1",
    "zod": "^4.6.7"
  }
}
