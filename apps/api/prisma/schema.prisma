generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  AUDITOR
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StepStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum DecisionMode {
  ANY
  ALL
}

enum AssigneeDecision {
  APPROVED
  REJECTED
}

enum NotificationType {
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  APPROVAL_EXPIRED
  GENERIC
}

enum ConnectorType {
  HTTP
  WEBHOOK
  CUSTOM
}

enum AuthType {
  NONE
  API_KEY
  BEARER
  BASIC
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum IntegrationDirection {
  OUTBOUND
  INBOUND
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  EXTRACTED
  VALIDATED
  NEEDS_REVIEW
  FAILED
}

enum DocumentType {
  INVOICE
  ID_DOCUMENT
  GENERIC
  UNKNOWN
}

enum ValidationSeverity {
  ERROR
  WARNING
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  name         String
  passwordHash String
  memberships  Membership[]
  refreshTokens RefreshToken[]
  requestedApprovals Approval[] @relation("ApprovalRequester")
  approvalAssignees ApprovalAssignee[]
  notifications Notification[]
  connectors Connector[] @relation("ConnectorCreator")
  uploadedDocuments Document[] @relation("DocumentUploader")
  documentCorrections DocumentCorrection[] @relation("DocumentCorrector")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Organization {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  slug         String        @unique
  memberships  Membership[]
  agents       Agent[]
  workflows    Workflow[]
  executions   WorkflowExecution[]
  approvals    Approval[]
  notifications Notification[]
  connectors Connector[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents WebhookEvent[]
  webhookSubscriptions WebhookSubscription[]
  integrationLogs IntegrationLog[]
  documents    Document[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  empresaId       String         @db.Uuid
  uploadedById    String         @db.Uuid
  originalName    String
  mimeType        String
  sizeBytes       Int
  sha256          String
  storageKey      String
  status          DocumentStatus @default(UPLOADED)
  docType         DocumentType   @default(UNKNOWN)
  pageCount       Int?
  ocrText         String?        @db.Text
  ocrConfidence   Float?
  extractedData   Json?
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  processedAt     DateTime?
  empresa         Organization   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  uploadedBy      User           @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  validations     DocumentValidation[]
  corrections     DocumentCorrection[]

  @@unique([empresaId, sha256])
  @@index([empresaId, status])
  @@index([empresaId, createdAt])
}

model DocumentValidation {
  id         String            @id @default(uuid()) @db.Uuid
  documentId String            @db.Uuid
  rule       String
  field      String
  severity   ValidationSeverity
  passed     Boolean
  message    String
  createdAt  DateTime          @default(now())
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

model DocumentCorrection {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  userId     String   @db.Uuid
  previousData Json
  newData     Json
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation("DocumentCorrector", fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

model Connector {
  id                  String      @id @default(uuid()) @db.Uuid
  companyId           String      @db.Uuid
  name                String
  type                ConnectorType
  baseUrl             String?
  authType            AuthType    @default(NONE)
  encryptedCredentials String?
  defaultHeaders      Json        @default("{}")
  isActive            Boolean     @default(true)
  createdById         String      @db.Uuid
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  company             Organization @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy           User        @relation("ConnectorCreator", fields: [createdById], references: [id], onDelete: Cascade)
  integrationLogs     IntegrationLog[]
  @@unique([companyId, name])
  @@index([companyId, createdAt])
  @@index([companyId, id])
}

model WebhookEndpoint {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @db.Uuid
  name           String
  slug           String      @unique
  secretHash     String
  encryptedSecret String?
  isActive       Boolean     @default(true)
  lastReceivedAt DateTime?
  createdAt      DateTime    @default(now())
  company        Organization @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events         WebhookEvent[]
  @@index([companyId, createdAt])
}

model WebhookEvent {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @db.Uuid
  endpointId     String             @db.Uuid
  headers        Json
  body           Json
  signatureValid Boolean
  status         WebhookEventStatus @default(RECEIVED)
  createdAt      DateTime           @default(now())
  company        Organization       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  endpoint       WebhookEndpoint    @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  @@index([companyId, createdAt])
  @@index([endpointId, status, createdAt])
}

model WebhookSubscription {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String       @db.Uuid
  url             String
  eventTypes      String[]
  encryptedSecret String
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  company        Organization @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, createdAt])
}

model IntegrationLog {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @db.Uuid
  connectorId     String?             @db.Uuid
  direction       IntegrationDirection
  method          String
  url             String
  requestHeaders  Json
  statusCode      Int?
  durationMs      Int
  success         Boolean
  errorMessage    String?
  attempt         Int
  createdAt       DateTime            @default(now())
  company        Organization         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connector       Connector?          @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  @@index([companyId, createdAt])
  @@index([companyId, connectorId])
}

model Membership {
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role         @default(OPERATOR)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}

model Agent {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @db.Uuid
  name               String
  description        String?
  systemInstructions String
  model              String      @default("claude-sonnet-4-5")
  maxStepsPerRun     Int         @default(10)
  monthlyTokenBudget Int?
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tools              AgentTool[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([organizationId])
  @@unique([organizationId, name])
}

model AgentTool {
  id       String @id @default(uuid()) @db.Uuid
  agentId  String @db.Uuid
  toolName String
  agent    Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolName])
}

model Workflow {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  description    String?
  draft          Json             @default("{\"nodes\":[],\"edges\":[]}")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       WorkflowVersion[]
  executions   WorkflowExecution[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@unique([organizationId, name])
}

model WorkflowVersion {
  id          String   @id @default(uuid()) @db.Uuid
  workflowId  String   @db.Uuid
  version     Int
  definition  Json
  createdById String?  @db.Uuid
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]
  createdAt   DateTime @default(now())

  @@unique([workflowId, version])
}

model WorkflowExecution {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  workflowId      String          @db.Uuid
  workflowVersionId String        @db.Uuid
  status          ExecutionStatus @default(QUEUED)
  input           Json
  error           String?
  idempotencyKey  String?
  triggeredById   String?         @db.Uuid
  lockedUntil     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  steps           ExecutionStep[]
  approvals       Approval[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([status])
}

model Approval {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  workflowRunId  String?        @db.Uuid
  title          String
  description    String?
  payload        Json
  status         ApprovalStatus @default(PENDING)
  decisionMode   DecisionMode   @default(ANY)
  requestedById  String         @db.Uuid
  expiresAt      DateTime?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        Organization   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflowRun    WorkflowExecution? @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  requestedBy    User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  assignees      ApprovalAssignee[]
  notifications  Notification[]

  @@index([companyId, status])
}

model ApprovalAssignee {
  id         String            @id @default(uuid()) @db.Uuid
  approvalId String            @db.Uuid
  userId     String            @db.Uuid
  decision   AssigneeDecision?
  comment    String?
  decidedAt  DateTime?
  approval   Approval          @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([approvalId, userId])
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  companyId  String           @db.Uuid
  userId     String           @db.Uuid
  approvalId String?          @db.Uuid
  type       NotificationType
  title      String
  body       String
  data       Json
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  company    Organization     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  approval   Approval?        @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
}

model ExecutionStep {
  id          String      @id @default(uuid()) @db.Uuid
  executionId String      @db.Uuid
  nodeId      String
  nodeType    String
  status      StepStatus
  attempt     Int
  output      Json?
  error       String?
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}
