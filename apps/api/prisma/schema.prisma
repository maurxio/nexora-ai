generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  AUDITOR
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StepStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  name         String
  passwordHash String
  memberships  Membership[]
  refreshTokens RefreshToken[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Organization {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  slug         String        @unique
  memberships  Membership[]
  agents       Agent[]
  workflows    Workflow[]
  executions   WorkflowExecution[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Membership {
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role         @default(OPERATOR)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}

model Agent {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @db.Uuid
  name               String
  description        String?
  systemInstructions String
  model              String      @default("claude-sonnet-4-5")
  maxStepsPerRun     Int         @default(10)
  monthlyTokenBudget Int?
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tools              AgentTool[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([organizationId])
  @@unique([organizationId, name])
}

model AgentTool {
  id       String @id @default(uuid()) @db.Uuid
  agentId  String @db.Uuid
  toolName String
  agent    Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolName])
}

model Workflow {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  description    String?
  draft          Json             @default("{\"nodes\":[],\"edges\":[]}")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       WorkflowVersion[]
  executions   WorkflowExecution[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@unique([organizationId, name])
}

model WorkflowVersion {
  id          String   @id @default(uuid()) @db.Uuid
  workflowId  String   @db.Uuid
  version     Int
  definition  Json
  createdById String?  @db.Uuid
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]
  createdAt   DateTime @default(now())

  @@unique([workflowId, version])
}

model WorkflowExecution {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  workflowId      String          @db.Uuid
  workflowVersionId String        @db.Uuid
  status          ExecutionStatus @default(QUEUED)
  input           Json
  error           String?
  idempotencyKey  String?
  triggeredById   String?         @db.Uuid
  lockedUntil     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  steps           ExecutionStep[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([status])
}

model ExecutionStep {
  id          String      @id @default(uuid()) @db.Uuid
  executionId String      @db.Uuid
  nodeId      String
  nodeType    String
  status      StepStatus
  attempt     Int
  output      Json?
  error       String?
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}
